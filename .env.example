# Your Courier API key, from https://app.courier.com/settings/api-keys
# Copy this file to .env and paste your key in.
COURIER_API_KEY=YOUR_COURIER_API_KEY

# Where the demo digest goes. Use the email you signed up to Courier with:
# every workspace can email its own members before you connect a provider.
DEMO_EMAIL=you@example.com

# Printed by `npm run setup`. Leave it empty the first time.
COURIER_DIGEST_JOURNEY_ID=

# How long a batch collects comments before the digest sends (ISO 8601).
# P1D is a daily digest. Set PT1M and rerun `npm run setup` to test in a minute.
DIGEST_WINDOW=P1D
