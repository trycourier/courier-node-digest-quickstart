{
  "name": "courier-node-digest-quickstart",
  "version": "1.0.0",
  "private": true,
  "description": "Batch comment notifications into one daily digest email per user, from a Node.js backend, with a Courier journey and its Batch node.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup": "tsx --env-file=.env scripts/setup.ts",
    "dev": "tsx watch --env-file=.env server.ts",
    "start": "tsx --env-file=.env server.ts",
    "send": "tsx --env-file=.env scripts/send.ts",
    "build": "tsc"
  },
  "dependencies": {
    "@trycourier/courier": "^10.1.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
